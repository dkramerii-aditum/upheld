# Upheld environment variables.
# Do not copy this file by hand: run  npm run setup:env -- --pg-user ... (see README)
# which writes .env (development) and .env.test (tests) with fresh secrets.

# Owner connection. Used only by migrations and owner scripts, never by the app.
DATABASE_OWNER_URL="postgresql://USER:PASSWORD@localhost:5432/upheld_dev"

# Password for the restricted upheld_app role. The app connects as upheld_app,
# which row level security always applies to. The app builds its connection
# from DATABASE_OWNER_URL (host and database) plus this password.
APP_DB_PASSWORD="generate-with-openssl-rand-hex-24"

# 32 byte key for field level encryption, as 64 hex characters or base64.
# Losing this key makes encrypted data unreadable. Back it up securely.
FIELD_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# Base URL used in sign in links.
APP_BASE_URL="http://localhost:3000"

# Staff email: console (development only, prints links to the terminal),
# resend, or disabled.
EMAIL_PROVIDER="console"
EMAIL_FROM=""
RESEND_API_KEY=""

# Staff session limits. Idle is capped at 60 minutes in code.
SESSION_IDLE_MINUTES="30"
SESSION_MAX_HOURS="12"

# Used from M5 on.
ANTHROPIC_API_KEY=""

# Used only by npm run db:seed to create your test sign in.
SEED_STAFF_EMAIL=""
